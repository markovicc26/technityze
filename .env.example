# Zoho Mail — SMTP for the /contact form (https://www.zoho.com/mail/help/zoho-smtp.html)
# Use an application-specific password if your account has 2FA.
# EU-hosted mailboxes often use smtp.zoho.eu instead of smtp.zoho.com.
# Paid org EU outgoing is often smtppro.zoho.eu (see Zoho Mail → IMAP/SMTP help).
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
# SMTP login — use the mailbox whose app password you generated (often the *primary* address).
ZOHO_SMTP_USER=info@technityze.com
ZOHO_SMTP_PASS=
# Optional. If Zoho only lets you SMTP-login as info@ but you want "From: form@…", set:
# ZOHO_SMTP_FROM=form@technityze.com
# (Alias must be allowed to send in Zoho; otherwise From may be rewritten to the primary address.)
ZOHO_SMTP_FROM=
# Inbox that receives contact form submissions.
# If this equals ZOHO_SMTP_USER, Zoho webmail may label threads as "Me" (same mailbox).
# Use another mailbox on the same domain (e.g. contact@) and keep ZOHO_SMTP_USER=info@
# if Zoho allows sending from info@ to contact@ — or create leads@ and forward to info.
CONTACT_NOTIFY_EMAIL=info@technityze.com

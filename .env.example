# Zoho Mail — SMTP for the /contact form (https://www.zoho.com/mail/help/zoho-smtp.html)
# Use an application-specific password if your account has 2FA.
# EU-hosted mailboxes often use smtp.zoho.eu instead of smtp.zoho.com.
# Paid org EU outgoing is often smtppro.zoho.eu (see Zoho Mail → IMAP/SMTP help).
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
# SMTP login — use the mailbox whose app password you generated.
ZOHO_SMTP_USER=contact@technityze.com
ZOHO_SMTP_PASS=
# Optional visible "From" if it differs from ZOHO_SMTP_USER (alias must be allowed in Zoho).
ZOHO_SMTP_FROM=
# Inbox that receives contact form submissions (usually same as ZOHO_SMTP_USER).
CONTACT_NOTIFY_EMAIL=contact@technityze.com
